# ---------------------------------------------------------------------------
# ChotuG Purchase API — copy to server/.env and edit
# ---------------------------------------------------------------------------
PORT=4000
DATABASE_URL=postgres://chotug:chotug@localhost:5432/chotug_erp
PG_POOL_MAX=12

# CHANGE THIS before any real deployment
JWT_SECRET=dev-only-change-me
ACCESS_TTL=8h

WEB_ORIGIN=http://localhost:5173
FINANCIAL_YEAR=2026-27

# --- AI -------------------------------------------------------------------
# rules | openrouter | groq | ollama
# "rules" needs no key: forecasts, buy quantities and anomaly detection are
# computed from your own data. Only the written explanations are lost.
AI_PROVIDER=rules
AI_API_KEY=
AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
AI_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
AI_BASE_URL=
AI_TIMEOUT_MS=20000
